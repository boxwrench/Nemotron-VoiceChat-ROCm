diff --git a/tools/voicechat/voicechat-cli.cpp b/tools/voicechat/voicechat-cli.cpp
index 10facb2ae..8a138d36d 100644
--- a/tools/voicechat/voicechat-cli.cpp
+++ b/tools/voicechat/voicechat-cli.cpp
@@ -1280,14 +1280,29 @@ static bool vc_say(vc_session & sess, const std::string & text, int pace, const

     for (llama_token tok : toks) {
         sess.tts_feed(tok);
+        if (getenv("VC_TTS_SCRATCH_TRACE")) {
+            LOG_INF("voicechat-tts: scratch input token=%d frame=%d silence_cos=%.6f\n",
+                    (int) tok, voicechat_tts_n_frames(sess.tts),
+                    voicechat_tts_silence_cos(sess.tts));
+        }
         for (int i = 1; i < pace; ++i) {
             sess.tts_feed(sess.tok_pad);
+            if (getenv("VC_TTS_SCRATCH_TRACE")) {
+                LOG_INF("voicechat-tts: scratch input pad frame=%d silence_cos=%.6f\n",
